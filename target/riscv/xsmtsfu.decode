#
# RISC-V XSmtsfu instruction encodings
#
# Opcode: custom-1 = 0101011 (0x2b)
#
# SFU instructions use vector-like vd/vs2 fields in the encoding, but the
# AME acceptance requirements constrain both operands to tile registers tr0..tr3.
# The translator rejects any vd/vs2 value outside 0..3.

# === Field extractions ===
%xsmtsfu_vd5     7:5          # destination tile register field vd[4:0]
%xsmtsfu_vs2_5   20:5         # source tile register field vs2[4:0]
%xsmtsfu_vm      25:1         # mask bit, decoded for completeness

# === Argument sets ===
&xsmtsfu_unary   xsmtsfu_vd5 xsmtsfu_vs2_5 xsmtsfu_vm

# === Instruction formats ===
@xsmtsfu_unary   .... .... .... .... .... .... .... ....   &xsmtsfu_unary xsmtsfu_vd5=%xsmtsfu_vd5 xsmtsfu_vs2_5=%xsmtsfu_vs2_5 xsmtsfu_vm=%xsmtsfu_vm

# === SFU: fp32 tile elementwise operations ===
vfex2_v          0100 11 . ..... 00111 001 ..... 0101011      @xsmtsfu_unary
vftanh_v         0100 11 . ..... 00111 010 ..... 0101011      @xsmtsfu_unary
vflg2_v          0100 11 . ..... 00111 011 ..... 0101011      @xsmtsfu_unary
vfrcp_v          0100 11 . ..... 00111 100 ..... 0101011      @xsmtsfu_unary
